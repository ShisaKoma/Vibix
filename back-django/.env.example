DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
POSTGRES_DB=vibix
POSTGRES_USER=vibix
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
WEB_PORT=8010

# SMTP par site : destinations approuvées (noms exacts, séparés par des virgules).
SITE_SMTP_ALLOWED_HOSTS=
# Installer le secret du site client concerné dans l’environnement, sans le commiter :
# SITE_SMTP_PASSWORD_<ID_DU_SITE>=

# Origine HTTPS du CMS pour le lien privé des notifications (vide : pas de lien).
CONTACTS_ADMIN_BASE_URL=
# IP exactes des seuls proxys autorisés à fournir X-Contacts-Client-IP.
# Ne configurer qu’avec en-tête remplacé par le proxy et backend isolé.
CONTACTS_TRUSTED_PROXY_IPS=
